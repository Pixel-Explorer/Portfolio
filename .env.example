# Copy this file to ".env.local" and fill in the real values.
# ".env.local" is gitignored — NEVER commit real tokens.
#
# Vercel Blob (used by scripts/upload-city-blob.mjs and any proof-media migration).
# Get these from: Vercel dashboard -> Storage -> <your Blob store> -> ".env.local" tab.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=
