# Dependencies — restored via `npm install`. The runtime uses CDN import maps,
# so node_modules is dev-tooling only (static server + asset pipeline scripts).
node_modules/

# Local probes and batch-build intermediates.
scratch/

# Claude Code local project config
.claude/

# Large GLB compositions — served from Vercel Blob CDN, not git
public/models/main city composition.glb

# Raw full-res gallery photos (2.1GB of ~29MB Fujifilm JPEGs). These are the
# SOURCE — web-optimized derivatives (resize + WebP + thumbnails) are what get
# committed/served. Don't commit the raw originals.
public/proof/Gallery/

# Proof media now lives on Vercel Blob (migrated 23 Jun 2026). ledger.json + landing.html
# reference the CDN URLs; nothing under public/proof/ is committed anymore. Files stay on
# disk locally as the upload source. Re-upload via scripts/migrate-proof-to-blob.mjs.
public/proof/

# Raw proof source material — only .webp derivatives (+ PDFs ≤95MB) get committed.
public/proof/**/*.[Jj][Pp][Gg]
public/proof/**/*.[Jj][Pp][Ee][Gg]
public/proof/**/*.[Pp][Nn][Gg]
public/proof/**/*.[Tt][Ii][Ff]
public/proof/**/*.[Tt][Ii][Ff][Ff]
public/proof/**/*.[Mm][Pp]4
public/proof/**/*.[Mm][Oo][Vv]

# OS / editor cruft
.DS_Store
Thumbs.db

# Playwright test artifacts — screenshots, traces, results.
test-results/
playwright-report/

# Local holding bin for retired/redundant files — kept on disk as a safety net,
# never committed. See cleanup pass 2026-06-16.
bin/

# Secrets — env files (e.g. BLOB_READ_WRITE_TOKEN for Vercel Blob). NEVER commit.
.env
.env.*
!.env.example

# Local dev-server logs (static-server stdout/stderr capture).
server_out.txt
server_err.txt

# Backup snapshots — the canonical data is data/ledger.json; .bak files are
# local-only and must never be committed (re-bloats the repo).
*.bak

# Regenerable graphify AST cache (rebuilt by `graphify update .`). The curated
# graph outputs (graph.json/.graphify_labels.json) are still tracked.
graphify-out/cache/

# AI tooling local state (mirrors .claude/ above) — never committed.
.agents/
.codex/
.impeccable/
skills-lock.json

# Scratch scripts at project root (agent-generated debug/test scripts).
scratch_*.js

# Temp video files.
temp_video*.mp4

# Graphify backups and text dumps
graphify-out/202*/
graphify-out/graph.txt
