{
  "name": "portfolio-ledger",
  "version": "1.0.0",
  "description": "Chronological portfolio with 3D archive terrain",
  "scripts": {
    "start": "http-server .",
    "dev": "node scripts/static-server.mjs",
    "test": "node story/selftest-precommit.js",
    "test:browser": "echo 'Open ?story&selftest in a browser to run full story selftest'",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --headed",
    "lint": "npx eslint app.js terrain.js landing.js story/ && npx eslint scripts/ bin/ e2e/",
    "lint:all": "npx eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "@vercel/blob": "^2.4.0",
    "draco3d": "^1.5.7",
    "eslint": "^10.5.0",
    "exifr": "^7.1.3",
    "globals": "^17.6.0",
    "http-server": "^14.1.1",
    "meshoptimizer": "^1.1.1",
    "obj2gltf": "^3.2.0",
    "playwright": "^1.61.0",
    "sharp": "^0.34.5"
  }
}
